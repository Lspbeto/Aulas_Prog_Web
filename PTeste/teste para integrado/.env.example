# Copie este arquivo para ".env" (cp .env.example .env) e preencha os valores.
# O arquivo ".env" NUNCA vai para o GitHub (está no .gitignore).

# Endereço do banco. Local: mongodb://127.0.0.1:27017/despensa
# Atlas: mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/despensa?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/despensa

# Chave secreta para assinar os tokens de login. Use um texto longo e aleatório.
# Para gerar:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Porta local (o Render define a sua própria)
PORT=3000
